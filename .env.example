# ══════════════════════════════════════════════════
#  VIDEO AUTO-CLIPPER — Environment Configuration
# ══════════════════════════════════════════════════
# Copy this file to .env and fill in your API keys.
#   cp .env.example .env

# ─── Flask Settings ───
FLASK_SECRET_KEY=change-this-to-a-random-string
FLASK_DEBUG=false
PORT=5000

# ─── LLM API Keys (Optional — NLP analysis works without these) ───
# These are ONLY used as fallback when NLP scoring finds too few hooks.
# Leave blank to use NLP-only mode (works great for most videos).

# Groq — Fast inference with Llama/Mixtral
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# NVIDIA NIM
# Get your key at: https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Which LLM to try first: groq, gemini, or nvidia
LLM_PROVIDER=groq

# ─── Cookie Auth (Optional — for private/restricted content) ───
# Export cookies from your browser (Netscape format) for platforms
# that require login: Instagram private, age-restricted YouTube,
# LinkedIn, Facebook private videos, etc.
# Use a browser extension like "Get cookies.txt" to export.
COOKIES_FILE=
